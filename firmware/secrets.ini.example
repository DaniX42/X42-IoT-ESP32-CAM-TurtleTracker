[env:ai_thinker]
custom_api_url = http://your-backend-host:8000
custom_mqtt_host = your-mqtt-host
custom_mqtt_port = 1888
custom_mqtt_user = your-mqtt-user
custom_mqtt_password = your-mqtt-password
custom_wifi_ssid = your-wifi-ssid
custom_wifi_password = your-wifi-password
custom_device_name = turtle-cam-outdoor
custom_ota_password = choose-a-strong-ota-password
build_flags =
	-DCORE_DEBUG_LEVEL=1
	-DCAMERA_MODEL_AI_THINKER
	-DTT_API_URL=\"http://your-backend-host:8000\"
	-DTT_MQTT_HOST=\"your-mqtt-host\"
	-DTT_MQTT_PORT=1888
	-DTT_MQTT_USER=\"your-mqtt-user\"
	-DTT_MQTT_PASSWORD=\"your-mqtt-password\"
	-DTT_WIFI_SSID=\"your-wifi-ssid\"
	-DTT_WIFI_PASSWORD=\"your-wifi-password\"
	-DTT_DEVICE_NAME=\"turtle-cam-outdoor\"
	-DTT_OTA_PASSWORD=\"choose-a-strong-ota-password\"
